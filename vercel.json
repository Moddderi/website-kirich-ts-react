{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "apps/client/dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.kirich-sewing-studio.com" }],
      "destination": "https://kirich-sewing-studio.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "website-kirich-ts-react.vercel.app" }],
      "destination": "https://kirich-sewing-studio.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:file(favicon.ico|favicon.png|favicon-16.png|favicon-32.png|favicon-48.png|apple-touch-icon.png|android-chrome-192.png|android-chrome-512.png|kirich-icon.png|vite.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
