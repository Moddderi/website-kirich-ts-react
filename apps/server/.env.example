# Server environment
PORT=5005
DATABASE_URL=

# Telegram (manager notifications)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Resend (client order confirmation emails)
RESEND_API_KEY=
# For testing you can use Resend's sandbox sender.
# When your domain is verified, switch e.g. to:
# EMAIL_FROM="K.I.RICH <noreply@kirich.studio>"
EMAIL_FROM="K.I.RICH <onboarding@resend.dev>"
EMAIL_REPLY_TO=kirich.sewing.studio@gmail.com

# Studio availability calendar (individual tailoring)
# Google Sheets → File → Share → Publish to web → CSV → paste the link.
# Columns: from | to | status (free / limited / busy) | note
AVAILABILITY_SHEET_CSV_URL=

# Studio workload from the Notion orders database (automatic, by deadlines).
# Notion → Settings → Connections → create API token (Read content only),
# then open the database → ··· → Connections → add it. Database id = 32 chars before "?v=".
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Studio takes ONE order at a time by default (any day inside an active order is busy).
# Raise if several orders can run in parallel: >= BUSY orders/day → "busy",
# optionally >= LIMITED (smaller than BUSY) → "few slots".
# NOTION_CAPACITY_BUSY=1
# NOTION_CAPACITY_LIMITED=
# Comma separated status names (contains, case-insensitive) that do NOT occupy the studio.
# NOTION_DONE_STATUSES=Відправлено,Видано,Скасовано
# Property names, only needed if auto-detection fails.
# NOTION_PROP_STATUS=Status
# NOTION_PROP_PERIOD=Термін виконання
